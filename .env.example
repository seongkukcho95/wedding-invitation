VITE_NAVER_MAP_CLIENT_ID=
VITE_KAKAO_SDK_JS_KEY=
# 참석 의사 전달 기능을 사용할 때만 서버 주소를 설정합니다.
VITE_SERVER_URL=
VITE_STATIC_ONLY=true

# 개인정보는 .env.local에 입력하고 커밋하지 마세요.
# GitHub 배포 시에는 같은 이름의 Actions Secrets를 설정합니다.
# 빈 값은 연락처·계좌 모달에서 숨겨집니다.
# 계좌 값에는 은행명과 계좌번호를 함께 입력합니다.
VITE_GROOM_PHONE=
VITE_GROOM_ACCOUNT=
VITE_GROOM_MOTHER_PHONE=
VITE_GROOM_MOTHER_ACCOUNT=
VITE_BRIDE_PHONE=
VITE_BRIDE_ACCOUNT=
VITE_BRIDE_FATHER_PHONE=
VITE_BRIDE_FATHER_ACCOUNT=
VITE_BRIDE_MOTHER_PHONE=
VITE_BRIDE_MOTHER_ACCOUNT=
